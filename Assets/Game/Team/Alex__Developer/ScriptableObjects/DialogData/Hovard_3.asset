  _name: "\u0413\u043E\u0432\u0430\u0440\u0434"
  _texts:
  - text: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0435\u0449\u0451 \u0445\u043E\u0440\u043E\u0448\u0438\u0435
      \u0431\u0443\u0434\u0443\u0442?"
  - text: "\u0422\u043E \u0435\u0441\u0442\u044C, \u043F\u0440\u043E\u0446\u0435\u0441\u0441
      \u043F\u043E\u0447\u0438\u043D\u043A\u0438 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u043C\u0435\u043D\u044F \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u0438\u0434\u0451\u0442?
      \u0418 \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \u0434\u0440\u043E\u043D\u044B?"
