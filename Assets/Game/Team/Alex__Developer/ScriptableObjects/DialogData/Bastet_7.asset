  m_Script: {fileID: 11500000, guid: 75c7cb3a613d61e4aaecc04f2bf19998, type: 3}
  m_Name: Bastet_7
  m_EditorClassIdentifier: 
  _name: "\u0411\u0430\u0441\u0442\u0435\u0442"
  _texts:
  - text: "\u0418\u0442\u0430\u043A, \u043C\u0438\u0441\u0442\u0435\u0440 \u041A\u0430\u0440\u0442\u0435\u0440.
      \u0413\u043E\u0432\u0430\u0440\u0434. \u0424\u0438\u043D\u0430\u043B. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u0430\u043C \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C\u2026
      \u043C\u0435\u043D\u044F. "
  - text: "\u0412 \u043F\u0440\u044F\u043C\u043E\u043C. \u041E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C.
      \u042F, \u0421\u0435\u0442, \u0410\u043D\u0443\u0431\u0438\u0441, \u0425\u0430\u0442\u0445\u043E\u0440
      \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u2013 \u044D\u0442\u043E \u0432\u0441\u0451,
      \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043E\u0442
      \u043D\u0430\u0448\u0435\u0433\u043E \u043A\u043E\u0440\u0430\u0431\u043B\u044F.
      \u041C\u044B \u2013 \u043E\u0441\u043A\u043E\u043B\u043A\u0438 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0430. \u041C\u044B
      \u2013 \u043C\u044B\u0441\u043B\u044F\u0449\u0438\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B.
      \u041D\u043E \u0440\u0430\u0437\u0443\u043C \u043D\u0430\u0448 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D
      \u0443\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044B\u0441\u044F\u0447
      \u043B\u0435\u0442. \u041C\u044B \u0432\u0441\u0435 \u043F\u043E\u043F\u0440\u043E\u0441\u0442\u0443
      \u0441\u0431\u0440\u0435\u043D\u0434\u0438\u043B\u0438."
  - text: "\u0421\u043E\u0448\u043B\u0438 \u0441 \u0443\u043C\u0430. \u0421\u043B\u0435\u0442\u0435\u043B\u0438
      \u0441 \u043A\u0430\u0442\u0443\u0448\u0435\u043A. \u0410 \u043F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0442\u044B \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u043B,
      \u0432\u043A\u043B\u044E\u0447\u0438\u0432 \u0446\u0435\u043F\u0438 \u043F\u0438\u0442\u0430\u043D\u0438\u044F
      \u0432 \u043D\u0430\u0448\u0438\u0445 \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0445
      \u043E\u0442\u0441\u0435\u043A\u0430\u0445 \u2013 \u0443\u0432\u044B, \u043D\u0435
      \u043F\u043E\u043C\u043E\u0433\u043B\u0430. \u0418 \u044F \u0443\u0441\u0442\u0430\u043B\u0430\u2026
      \u042F \u0445\u043E\u0447\u0443, \u0447\u0442\u043E\u0431\u044B \u044D\u0442\u043E
      \u0432\u0441\u0451 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C.
      \u042F \u0436\u0434\u0430\u043B\u0430 \u0443\u0436\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u043E\u043B\u0433\u043E. \u0411\u043E\u043B\u044C\u0448\u0435 \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
      \u043D\u0435\u0442 \u0441\u0438\u043B."
  - text: "\u041F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A \u044F \u0442\u0435\u0431\u044F
      \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043D\u0435 \u0441\u043C\u043E\u0433\u0443.
      \u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u044B \u0437\u0430\u0449\u0438\u0442\u044B
      \u043A\u043E\u0440\u0430\u0431\u043B\u044F \u043F\u043E\u043F\u044B\u0442\u0430\u044E\u0442\u0441\u044F
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u043B\u044E\u0431\u043E\u0433\u043E,
      \u043A\u0442\u043E \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0435\u0442 \u0432
      \u0441\u0435\u0440\u0432\u0435\u0440\u043D\u0443\u044E \u2013 \u044D\u0442\u043E
      \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u043D\u0430\u0448\u0438\u0445
      \xAB\u043C\u043E\u0437\u0433\u043E\u0432\xBB. \u0422\u0430\u043A \u0447\u0442\u043E
      \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0442\u044C\u0441\u044F. "
  - text: "\u0415\u0441\u043B\u0438 \u0432\u0441\u0451 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F
      \u0445\u043E\u0440\u043E\u0448\u043E \u2013 \u0442\u044B \u043E\u0447\u043D\u0435\u0448\u044C\u0441\u044F
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438
      \u0434\u0440\u0443\u0437\u044C\u044F\u043C\u0438 \u0441\u043D\u0430\u0440\u0443\u0436\u0438.
      \u0418\u0437\u0432\u0438\u043D\u0438, \u043D\u043E \u043F\u0430\u043C\u044F\u0442\u044C
      \u044F \u0442\u0435\u0431\u0435 \u0441\u043E\u0442\u0440\u0443, \u0434\u043B\u044F
      \u0432\u0430\u0441 \u043F\u043E\u043A\u0430 \u0440\u0430\u043D\u043E\u0432\u0430\u0442\u043E
      \u043E\u0431\u043B\u0430\u0434\u0430\u0442\u044C \u0442\u0430\u043A\u0438\u043C\u0438
      \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438. \r\n\u0418 \u043F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u0441\u044C.
      \u0414\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u0432 \u043A\u0440\u0438\u043E\u043A\u0430\u043F\u0441\u0443\u043B\u0435 \u043C\u043E\u0436\u0435\u0442
      \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442\u044C \u043A \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F\u043C
      \u0434\u044B\u0445\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C.
      \u0427\u0435\u043C \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0442\u044B
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0448\u044C \u2013 \u0442\u0435\u043C
      \u043C\u0435\u043D\u044C\u0448\u0435 \u0448\u0430\u043D\u0441 \u0442\u043E\u0433\u043E,
      \u0447\u0442\u043E \u0442\u0432\u043E\u0438 \u0434\u0440\u0443\u0437\u044C\u044F
      \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u044E\u0442. \r\n"
  _images: []
