  _name: "\u042D\u0432\u0435\u043B\u0438\u043D"
  _texts:
  - "\u0425\u043E\u0447\u0443 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C! "
  - "\u0412\u043E\u0442 \u0438\u043C\u0435\u043D\u043D\u043E, \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430!
    \u041A\u0430\u043A \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0438\u0434\u0435\u0442\u044C
    \u0437\u0434\u0435\u0441\u044C \u0441 \u0431\u043E\u043A\u0430\u043B\u0430\u043C\u0438,
    \u043A\u043E\u0433\u0434\u0430 \u0442\u0430\u043C - \u043D\u0435\u0440\u0430\u0437\u0433\u0430\u0434\u0430\u043D\u043D\u0430\u044F
    \u0442\u0430\u0439\u043D\u0430? \u041F\u043E\u0439\u0434\u0451\u043C\u0442\u0435
    \u0441\u043A\u043E\u0440\u0435\u0439! "
  - "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435! \u0415\u0449\u0451 \u043E\u0434\u043D\u0430
    \u0434\u0432\u0435\u0440\u044C! \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
    \u0447\u0442\u043E \u0442\u0430\u043C?"
