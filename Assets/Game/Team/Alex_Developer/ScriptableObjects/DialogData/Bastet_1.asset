  m_Script: {fileID: 11500000, guid: 75c7cb3a613d61e4aaecc04f2bf19998, type: 3}
  m_Name: Bastet_1
  m_EditorClassIdentifier: 
  _name: "\u0411\u0430\u0441\u0442\u0435\u0442"
  _texts:
  - text: "\u041D\u0435 \u0441\u043B\u044B\u0448\u0430\u0442. \u041C\u043E\u0436\u0435\u0448\u044C,
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0435\u0449\u0435 \u0441\u043F\u0435\u0442\u044C
      \u0438\u043B\u0438 \u0441\u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C.
      \u0422\u0432\u043E\u0438 \u0434\u0440\u0443\u0437\u044C\u044F \u043D\u0435
      \u043E\u0442\u043A\u043B\u0438\u043A\u043D\u0443\u0442\u0441\u044F. \u0425\u043E\u0442\u044F
      \u0438\u0434\u0435\u044F \u0441 \u0442\u0430\u043D\u0446\u0435\u043C \u0445\u043E\u0440\u043E\u0448\u0430,
      \u0434\u0430\u0432\u0430\u0439 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C."
  - text: "\u0424\u0443, \u043A\u0430\u043A \u0431\u0430\u043D\u0430\u043B\u044C\u043D\u043E.
      \u0423 \u0432\u0430\u0441 \u0447\u0442\u043E, \u0443 \u043B\u044E\u0434\u0438\u0448\u0435\u043A,
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u0430\u044F
      \u0432\u0448\u0438\u0442\u0430 \u0434\u043B\u044F \u0432\u0441\u0435\u0445?
      \u0412\u044B \u0432\u0441\u0435\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430
      \u0432\u0438\u0434\u0438\u0442\u0435 \u0431\u043E\u0436\u0435\u0441\u0442\u0432\u043E
      \u043D\u0430\u044F\u0432\u0443, \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0435,
      \u043A\u0442\u043E \u044D\u0442\u043E? \u0422\u044B \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0448\u044C,
      \u0433\u0434\u0435 \u043B\u043E\u0440\u0434, \u043D\u043E \u0434\u0435\u043B\u0430\u0435\u0448\u044C
      \u044D\u0442\u043E \u0431\u0435\u0437 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F.
      \u0414\u0430\u0432\u0430\u0439 \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C.
      \u0412\u044B\u0439\u0434\u0438 \u0438 \u0437\u0430\u0439\u0434\u0438 \u0432
      \u0437\u0430\u043B \u0435\u0449\u0451 \u0440\u0430\u0437, \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E."
  - text: "\u041E\u0439, \u043B\u0430\u0434\u043D\u043E, \u043A\u043E\u0442\u0438\u043A,
      \u043F\u043E\u0448\u0443\u0442\u0438\u043B\u0430 \u044F, \u043E\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044F.
      \u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u0411\u0430\u0441\u0442\u0435\u0442."
  - text: "\u0422\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438, \u043A\u0430\u043A
      \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u043B\u043E... \u0414\u0440\u0443\u0433\u0438\u0435
      \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u0432 \u0442\u0432\u043E\u0435\u0439
      \u0442\u0443\u043F\u043E\u0432\u0430\u0442\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u0451\u043D\u043A\u0435
      \u0438\u043C\u0435\u044E\u0442\u0441\u044F? \u041A\u0430\u043A \u0442\u0435\u0431\u044F
      \u0442\u0430\u043C? \u0413\u043E\u0432\u0430\u0440\u0434? \u041F\u0440\u0438\u0448\u0451\u043B
      \u043A \u0436\u0435\u043D\u0449\u0438\u043D\u0435 \u0434\u043E\u043C\u043E\u0439
      \u0438 \u0434\u043E\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442.
      \u041D\u0435\u0432\u0435\u0436\u043B\u0438\u0432\u043E. \u0410 \u044F \u0437\u043B\u0430\u044F
      \u0438 \u043F\u0430\u043C\u044F\u0442\u044C \u0443 \u043C\u0435\u043D\u044F
      \u0445\u043E\u0440\u043E\u0448\u0430\u044F. \u0412\u044B \u0441 \u0434\u0440\u0443\u0437\u044C\u044F\u043C\u0438
      \u0437\u0430\u043A\u0440\u044B\u0442\u0443\u044E \u0434\u0432\u0435\u0440\u044C
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0438? \u041E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0438.
      \u0422\u0430\u043A \u0447\u0442\u043E \u0434\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430 \u0431\u043E\u0440\u0442!"
  - text: "\u0412\u043E\u0442! \u041F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u043D\u0430
      \u0433\u043B\u0430\u0437\u0430\u0445! \u0423\u0436\u0435 \"\u043C\u0438\u0441\u0441\",
      \u043D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u044C
      \u044D\u0442\u0430 \u0432\u0430\u0448\u0430 \u0445\u0432\u0430\u043B\u0435\u043D\u0430\u044F
      \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0430\u044F \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F.
      \u0422\u044B \u0436\u0435 \u0434\u0436\u0435\u043D\u0442\u043B\u044C\u043C\u0435\u043D!
      \u0417\u0430\u0442\u043E\u0440\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0439,
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043D\u043E \u0447\u0442\u043E
      \u043F\u043E\u0434\u0435\u043B\u0430\u0442\u044C. \u041F\u0440\u043E \"\u0431\u043E\u0440\u0442\"
      \u044F \u0442\u0435\u0431\u0435 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443. \u0410
      \u0441\u0435\u0439\u0447\u0430\u0441 \u044F \u0445\u043E\u0447\u0443 \u0441\u044B\u0433\u0440\u0430\u0442\u044C
      \u0441 \u0442\u043E\u0431\u043E\u0439 \u0432 \u0438\u0433\u0440\u0443! \u0418
      \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0438\u0433\u0440\u0430\u0442\u044C,
      \u0413\u043E\u0434\u044F. \u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C
      \u0441\u043F\u0430\u0441\u0442\u0438 \u0434\u0440\u0443\u0437\u0435\u0439,
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E."
  - text: "\u0421\u0435\u0439\u0447\u0430\u0441 \u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u043F\u044F\u0442 \u0432 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445
      \u043A\u0430\u043F\u0441\u0443\u043B\u0430\u0445. \u041C\u044B \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u043B\u0438
      \u0438\u0445 \u0432 \u043A\u0440\u0438\u043E\u0441\u043E\u043D. \u0414\u0430\u0436\u0435
      \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C \u043D\u0435 \u0431\u0443\u0434\u0443,
      \u0447\u0442\u043E \u044D\u0442\u043E \u0442\u0430\u043A\u043E\u0435, \u0442\u044B
      \u043D\u0435 \u043F\u043E\u0439\u043C\u0451\u0448\u044C. \u0417\u0430\u043F\u043E\u043C\u043D\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E, \u0447\u0442\u043E \u044D\u0442\u043E
      \u043D\u0430\u0434\u043E\u043B\u0433\u043E, \u0438 \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044C
      \u0438\u0445 \u043C\u043E\u0436\u0435\u043C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043C\u044B. \u0415\u0441\u043B\u0438 \u0442\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0448\u044C
      \u043D\u0430\u0448\u0438 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0438
      \u0440\u0430\u0437\u0433\u0430\u0434\u0430\u0435\u0448\u044C \u0437\u0430\u0433\u0430\u0434\u043A\u0438.
      \u0413\u043E\u0442\u043E\u0432?"
  - text: "\u041D\u0435\u0442, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0433\u043B\u0443\u043F\u044B\u0439!
      \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u0434\u0432\u0435\u0440\u044C
      \u0438\u043B\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
      \u0434\u0432\u0435\u0440\u044C. \u0412\u043F\u0435\u0440\u0435\u0434!"
