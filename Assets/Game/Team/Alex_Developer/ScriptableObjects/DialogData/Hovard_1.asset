  _name: "\u0413\u043E\u0432\u0430\u0440\u0434"
  _texts:
  - "\u041B\u043E\u0440\u0434 \u041A\u0430\u0440\u043D\u0430\u0440\u0432\u043E\u043D!
    \u042D\u0432\u0435\u043B\u0438\u043D! \u0412\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435
    \u043C\u0435\u043D\u044F?"
  - "\u041A\u0442\u043E \u0442\u044B?! \u0413\u0434\u0435 \u043B\u043E\u0440\u0434
    \u0438 \u042D\u0432\u0435\u043B\u0438\u043D?"
  - "\u2026"
  - "\u0427\u0442\u043E \u0442\u044B \u0442\u0430\u043A\u043E\u0435?"
  - "\u0411\u043E\u0440\u0442 \u0447\u0435\u0433\u043E, \u044D-\u044D-\u044D... \u043C\u0438\u0441\u0441?"
  - "\u0410 \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0432\u044B\u0431\u043E\u0440?"
