  _name: "\u0413\u043E\u0432\u0430\u0440\u0434"
  _texts:
  - "\u0417\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u0430\u044F \u0434\u0432\u0435\u0440\u044C!
    \u0417\u043D\u0430\u0447\u0438\u0442, \u044D\u0442\u043E \u0432\u0435\u0440\u043D\u043E!
    \u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E \u043C\u044B\_ \u0432\u043E\u0437\u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u044B
    \u0437\u0430\_\u0432\u0441\u0435 \u0433\u043E\u0434\u044B \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u043E\u0433\u043E
    \u0442\u0440\u0443\u0434\u0430! "
  - "\u0414\u0430! \u0427\u0443\u0434\u0435\u0441\u043D\u044B\u0435 \u0432\u0435\u0449\u0438!"
  - "\u041B\u043E\u0440\u0434 \u041A\u0430\u0440\u043D\u0430\u0432\u043E\u043D! \u042D\u0432\u0435\u043B\u0438\u043D!
    \u0413\u0434\u0435 \u0436\u0435 \u0432\u044B? "
